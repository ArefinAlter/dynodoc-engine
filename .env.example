# Local development only. Create real secrets for hosted deployments.
# Create/provision this login first; keep operator credentials only in .env.migrate.
DATABASE_URL=postgres://dynodoc_runtime:REPLACE_WITH_RUNTIME_PASSWORD@127.0.0.1:5548/dynodoc_engine
API_HOST=127.0.0.1
API_PORT=8080
APP_ENV=development
# Generate: openssl rand -hex 32
PASETO_LOCAL_KEY=
# Required in every environment: at least 32 non-blank characters.
WEB_SERVICE_KEY=
ADMIN_EMAILS=

# Shared storage writers are independent opt-ins; use the current schema-34 reader.
# Periodic: legacy (default), shared-v1 or shared-v2. Draft/named: legacy or shared-v2.
# Keep legacy until measured rollout acceptance; see docs/ENGINE-EVOLUTION-HANDOFF.md.
DYNODOC_PERIODIC_CHECKPOINT_STORAGE=legacy
DYNODOC_SHARED_DRAFT_BASES=legacy
DYNODOC_NAMED_SNAPSHOT_STORAGE=legacy

# AI-agent read routes (/projects/{id}/agent/..., /.well-known/dynodoc-agent): off (default)
# or on. Off, they are not mounted and answer like any path that never existed. Read-only;
# see docs/AI-AGENT-CONNECTORS.md section 11.2.
AGENT_GATEWAY=off

# Secret files (optional): DATABASE_URL, PASETO_LOCAL_KEY and WEB_SERVICE_KEY may instead be
# given as NAME_FILE=/run/secrets/name with NAME unset (both set is a startup error). The
# file holds only the value (trailing line breaks are ignored), is at most 16 KiB and, on
# Unix, must not be readable by group or others unless DYNODOC_ALLOW_OPEN_SECRET_FILES=true.
# DATABASE_URL_FILE=
# PASETO_LOCAL_KEY_FILE=
# WEB_SERVICE_KEY_FILE=

# Retention (API background job): prunes expired sign-in links, refresh-token rows, request
# windows, device-enrollment challenges, old web metrics and expired idempotency records,
# one replica at a time. Never touches history, event, snapshot, audit or erasure tables.
# Values outside the bounds stop startup. The defaults are shown.
RETENTION_JOBS=on
# 60..86400
RETENTION_INTERVAL_SECONDS=3600
# Rows per DELETE statement, 10..10000
RETENTION_BATCH_ROWS=1000
# Days kept after a link, refresh row or challenge expired or was used up, 1..365
RETENTION_AUTH_DAYS=7
# Days of web_metric rows kept, 1..3650
RETENTION_METRICS_DAYS=30
