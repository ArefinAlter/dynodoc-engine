# Local development only. Create real secrets for hosted deployments.
DATABASE_URL=postgres://dynodoc:local-development-only@127.0.0.1:5548/dynodoc_engine
API_HOST=127.0.0.1
API_PORT=8080
APP_ENV=development
# Generate: openssl rand -hex 32
PASETO_LOCAL_KEY=
WEB_SERVICE_KEY=
ADMIN_EMAILS=

# Optional periodic shared checkpoint writer; requires schema 25 and latency acceptance.
# Readers support both formats regardless of this setting. See docs/SHARED-CHECKPOINTS.md.
DYNODOC_PERIODIC_CHECKPOINT_STORAGE=legacy
